# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# NOTE: values containing '#' MUST be quoted; an unquoted value is truncated at the '#'.

# Signs the session cookie (cookie-parser). Changing it invalidates all sessions.
COOKIE_SECRET=""

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# The public key is also hardcoded in web/scripts/sw-init.js — keep them in sync.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
